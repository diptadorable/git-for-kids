# Copy to .env.local and fill in.

# Required. Generate with:  npx auth secret
# (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=

# Optional. Without it the game runs with no accounts and saves progress
# only in the browser. With it, players get email logins and cross-device
# progress. Get one free from Vercel -> Storage -> Neon.
DATABASE_URL=
